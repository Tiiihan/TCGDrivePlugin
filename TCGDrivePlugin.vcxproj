  <!-- Translations: we compile .ts → .qm ourselves BEFORE rcc, so the .qm files
       end up embedded in translations.qrc. Qt VS Tools' native <QtTranslation>
       target runs AfterTargets="Link" (too late for rcc), so we cannot use it here.
       The .ts files are listed in TCGDrivePlugin.vcxproj.filters so they still
       show up in Solution Explorer for editing in Qt Linguist. -->
  <ItemGroup>
    <QtLReleaseTs Include="resources\translations\plugin_uk.ts">
      <QmOutput>resources\translations\plugin_uk.qm</QmOutput>
    </QtLReleaseTs>
    <QtLReleaseTs Include="resources\translations\plugin_en.ts">
      <QmOutput>resources\translations\plugin_en.qm</QmOutput>
    </QtLReleaseTs>
  </ItemGroup>
