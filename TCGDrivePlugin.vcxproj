  <Target Name="QtRunMoc" BeforeTargets="ClCompile" Inputs="@(QtMocHeader)" Outputs="@(QtMocHeader->'%(GeneratedFile)')">
    <Message Text="moc %(QtMocHeader.Filename)%(QtMocHeader.Extension)" Importance="high" />
