  <Target Name="QtBuildTranslations"
          BeforeTargets="QtRccInit;QtRcc"
          Inputs="@(QtLReleaseTs)"
          Outputs="@(QtLReleaseTs->'%(QmOutput)')">
    <Message Text="lrelease %(QtLReleaseTs.Filename)%(QtLReleaseTs.Extension)" Importance="high" />
    <Exec WorkingDirectory="$(ProjectDir)"
          Command="&quot;$(QtToolsPath)\lrelease.exe&quot; &quot;%(QtLReleaseTs.Identity)&quot; -qm &quot;%(QtLReleaseTs.QmOutput)&quot;" />
  </Target>
