  <!-- Paths are RELATIVE so the uic/moc/rcc/lrelease command text stays pure
       ASCII. The Exec tasks below set WorkingDirectory="$(ProjectDir)"; the
       project directory (which may contain spaces / Cyrillic / '+' / '!') is
       handed to the child process as a Unicode CWD and therefore never enters
       the cmd.exe batch file MSBuild generates in the system ANSI code page.
       This lets the project build from "dirty" paths, not only ASCII ones. -->
  <ItemGroup>
    <QtUiFile Include="resources\settings_dialog.ui">
      <GeneratedFile>generated\ui_settings_dialog.h</GeneratedFile>
    </QtUiFile>
    <QtUiFile Include="resources\progress_dialog.ui">
      <GeneratedFile>generated\ui_progress_dialog.h</GeneratedFile>
    </QtUiFile>
    <QtMocHeader Include="src\gui\auth_dialog.h">
      <GeneratedFile>generated\moc_auth_dialog.cpp</GeneratedFile>
    </QtMocHeader>
    <QtMocHeader Include="src\gui\settings_dialog.h">
      <GeneratedFile>generated\moc_settings_dialog.cpp</GeneratedFile>
    </QtMocHeader>
    <QtMocHeader Include="src\gui\progress_dialog.h">
